PORT=3000
JWT_SECRET=troque_por_uma_chave_secreta_forte_aqui

# ── PIX / PAGBANK ──────────────────────────────────────────────────────────────
# Chave Pix da loja (telefone, CPF, email ou chave aleatória)
PIX_KEY=+5511947291983
PIX_MERCHANT_NAME=Point dos Malokas
PIX_MERCHANT_CITY=Sao Paulo

# Link do perfil/loja no PagBank (botão "Abrir PagBank" no checkout)
PAGBANK_LINK=https://pagbank.com.br/pointdosmalokas

# ── CONFIRMAÇÃO AUTOMÁTICA DO PIX ─────────────────────────────────────────────
# Para ativar a confirmação automática do pagamento:
#
# 1. Entre no painel PagBank → Pix → Minha Conta → Webhooks
# 2. Cadastre a URL: https://SEU_DOMINIO.com/api/pagbank/webhook
# 3. Selecione o evento: "Pix recebido"
# 4. Pronto! Quando o cliente pagar, o sistema confirma automaticamente.
#
# IMPORTANTE: O webhook só funciona em servidor com domínio público (https).
# Para testes locais, use ngrok: ngrok http 3000
# URL ngrok ficará algo como: https://abc123.ngrok.io/api/pagbank/webhook

# ── ENDEREÇO DA LOJA ──────────────────────────────────────────────────────────
# Usado para calcular a rota até o cliente no painel admin
STORE_ADDRESS=Rua Esperantinópolis, 346, São Paulo, SP

# ── ADMIN ──────────────────────────────────────────────────────────────────────
# Credenciais do Admin (usadas só no primeiro start — mude depois pelo painel)
ADMIN_USER=admin
ADMIN_PASS=pointmalokas2025
